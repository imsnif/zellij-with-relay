# Picked up by BuildKit when building with -f zellij-relay-server/deploy/Dockerfile.
# Keeps the upload over the SSH docker context small and the build fast.

# Build artefacts
target/
**/target/

# VCS
.git/
.gitignore

# Editor / OS junk
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local configuration and secrets. The build context is uploaded to the
# remote Docker daemon, so exclude these even though the relay build does not
# reference them directly.
.env
.env.*
**/.env
**/.env.*
.dev.vars
**/.dev.vars
.secrets/
**/.secrets/
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
**/id_rsa
**/id_ed25519

# Pre-built WASM plugin artefacts (rebuilt by cargo if needed; relay doesn't use them)
assets/plugins/
**/*.wasm

# Docs & screenshots — not needed for a cargo build
docs/
screenshots/
*.gif
*.png
*.jpg
*.mp4

# The deploy dir itself — avoids recursion when the build context is the workspace root
zellij-relay-server/deploy/
